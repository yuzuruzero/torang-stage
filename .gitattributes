# Aturan akhir baris — pelajaran dari repo torang-murid:
# *.sh WAJIB LF (CRLF => "bad interpreter: /usr/bin/env bash^M")
# *.bat / *.ps1 WAJIB CRLF (cmd.exe bisa salah baca file ber-LF)
* text=auto
*.sh text eol=lf
*.mjs text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf

# binary
*.mp4 binary
*.m4a binary
*.mp3 binary
*.png binary
*.jpg binary
*.ico binary
*.woff2 binary
